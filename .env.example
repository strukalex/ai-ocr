# API
PORT=3000
GLOBAL_PREFIX=api
SESSION_IDLE_MINUTES=30

# TLS (optional for local HTTPS)
TLS_CERT_FILE=
TLS_KEY_FILE=

# Postgres (Prisma)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_ocr?schema=public

# Redis (BullMQ, locks)
REDIS_URL=redis://localhost:6379
QUEUE_PREFIX=bull

# MinIO (S3-compatible storage)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=documents

# Auth / Keycloak / JWT
KEYCLOAK_URL=http://localhost:8080/auth
KEYCLOAK_REALM=master
KEYCLOAK_CLIENT_ID=ai-ocr
KEYCLOAK_CLIENT_SECRET=change-me
# Provide a PEM-encoded public key for offline JWT verification (begin with -----BEGIN PUBLIC KEY-----)
KEYCLOAK_PUBLIC_KEY=
JWKS_URL=

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=ai-ocr-api

# Misc
NODE_ENV=development
