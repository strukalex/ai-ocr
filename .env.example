# API
PORT=3000
GLOBAL_PREFIX=api
SESSION_IDLE_MINUTES=30
REQUIRE_TLS=false
TRUST_PROXY=true
REQUIRE_AT_REST_ENCRYPTION=false
FORCE_SECURITY_VALIDATION_IN_TEST=false

# TLS (optional for local HTTPS)
TLS_CERT_FILE=
TLS_KEY_FILE=

# Postgres (Prisma)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_ocr?schema=public
DB_AT_REST_ENCRYPTED=true
# Alternative name accepted by the API; leave blank if unused
DATABASE_ENCRYPTION_ENABLED=

# Redis (BullMQ, locks)
REDIS_URL=redis://localhost:6379
QUEUE_PREFIX=bull

# MinIO (S3-compatible storage)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=documents
MINIO_ENFORCE_SSE=false
MINIO_SSE_ALGORITHM=AES256

# Auth / Keycloak / JWT
KEYCLOAK_URL=http://localhost:8080/auth
KEYCLOAK_REALM=master
KEYCLOAK_CLIENT_ID=ai-ocr
KEYCLOAK_CLIENT_SECRET=change-me
KEYCLOAK_TOKEN_URL=
# Provide a PEM-encoded public key for offline JWT verification (begin with -----BEGIN PUBLIC KEY-----)
KEYCLOAK_PUBLIC_KEY=
JWKS_URL=
LOCAL_AUTH_SECRET=secret
LOCAL_AUTH_USER=admin
LOCAL_AUTH_PASSWORD=admin
LOCAL_AUTH_ROLES=operator,admin
WORKER_AUTH_SECRET=

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=ai-ocr-api

# Misc
NODE_ENV=development
BULL_BOARD_ALLOW_LOCAL=true
ALLOW_PREPROCESSOR_TIMEOUT_FALLBACK=true