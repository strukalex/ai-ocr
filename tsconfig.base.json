{
  "$schema": "./node_modules/tsconfig/lib/tsconfig.schema.json",
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "baseUrl": ".",
    "paths": {
      "@my-org/shared-types": ["packages/shared-types/src/index.ts"],
      "@my-org/database": ["packages/database/src/index.ts"],
      "@my-org/queue": ["packages/queue/src/index.ts"],
      "@my-org/storage": ["packages/storage/src/index.ts"],
      "@my-org/observability": ["packages/observability/src/index.ts"]
    },
    "target": "ES2021",
    "module": "CommonJS",
    "lib": ["ES2021"],
    "moduleResolution": "node",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "types": ["node", "jest"]
  }
}
